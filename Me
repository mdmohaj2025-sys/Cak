<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Voice Room - Wave Edition</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0c0f14; display: flex; justify-content: center; align-items: center; height: 100vh; font-family: sans-serif; color: white; }

        .app-container {
            width: 350px; height: 550px; background: #161b22; border-radius: 30px;
            display: flex; flex-direction: column; border: 1px solid #30363d; overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5);
        }

        .header { padding: 20px; text-align: center; border-bottom: 1px solid #30363d; background: #1c2128; font-weight: bold; }

        .seats-grid { display: flex; flex-wrap: wrap; justify-content: space-around; padding: 40px 10px; gap: 20px; }
        
        .seat { display: flex; flex-direction: column; align-items: center; cursor: pointer; position: relative; width: 100px; }

        /* গোল সিট এবং এনিমেশন */
        .circle { 
            width: 85px; height: 85px; border-radius: 50%; background: #21262d; 
            display: flex; align-items: center; justify-content: center; 
            border: 3px solid #30363d; position: relative; z-index: 5;
            transition: 0.3s;
        }

        .avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; z-index: 6; }

        /* সমুদ্রের ঢেউ এনিমেশন */
        .wave-container {
            position: absolute; width: 85px; height: 85px;
            display: none; justify-content: center; align-items: center; z-index: 1;
        }

        .speaking .wave-container { display: flex; }

        .wave {
            position: absolute; width: 100%; height: 100%;
            border: 2px solid #00f2fe; border-radius: 50%;
            animation: ocean-wave 2s infinite linear; opacity: 0;
        }
        .wave:nth-child(2) { animation-delay: 0.6s; }
        .wave:nth-child(3) { animation-delay: 1.2s; }

        @keyframes ocean-wave {
            0% { transform: scale(1); opacity: 0.8; border-color: #00f2fe; }
            50% { transform: scale(1.4); opacity: 0.4; border-color: #4facfe; }
            100% { transform: scale(1.8); opacity: 0; border-color: #00f2fe; }
        }

        /* রিং লাইট আপ-ডাউন */
        .speaking .circle {
            animation: glow 1s infinite alternate;
            border-color: #00f2fe;
        }

        @keyframes glow {
            from { box-shadow: 0 0 10px #00f2fe; }
            to { box-shadow: 0 0 25px #00f2fe, inset 0 0 15px rgba(0,242,254,0.5); }
        }

        .label { margin-top: 12px; font-size: 13px; color: #8b949e; font-weight: bold; }
        #status-bar { font-size: 11px; text-align: center; padding: 10px; background: #21262d; color: #58a6ff; }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">অনলাইন ভয়েস রুম</div>
    <div id="status-bar">অনলাইনে কানেক্ট হচ্ছে...</div>

    <div class="seats-grid" id="seatsGrid">
        <div class="seat" id="seat-1" onclick="joinSeat(1)">
            <div class="wave-container"><div class="wave"></div><div class="wave"></div><div class="wave"></div></div>
            <div class="circle" id="img-1">🛋️</div>
            <div class="label" id="name-1">খালি সিট</div>
        </div>
        <div class="seat" id="seat-2" onclick="joinSeat(2)">
            <div class="wave-container"><div class="wave"></div><div class="wave"></div><div class="wave"></div></div>
            <div class="circle" id="img-2">🛋️</div>
            <div class="label" id="name-2">খালি সিট</div>
        </div>
    </div>
</div>

<script src="https://download.agora.io/sdk/release/AgoraRTC_N-4.22.0.js"></script>
<script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
    import { getDatabase, ref, set, onValue, onDisconnect } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

    // আপনার Firebase কনফিগ
    const firebaseConfig = {
        apiKey: "AIzaSyDXwE6T6fOBBIbxWIMBPJoHN4PD9NXazKw",
        databaseURL: "https://moi-project-25509-default-rtdb.firebaseio.com",
        projectId: "moi-project-25509",
        appId: "1:465225004410:web:e266146adb1ccaca4992c3"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);
    const agoraAppId = "eaa4c1fe1f4047168877cc9cd9f28c8d";
    
    const client = AgoraRTC.createClient({ mode: "rtc", codec: "vp8" });
    let localTracks = { audioTrack: null };
    let myCurrentSeat = null;
    const myName = "MOHAJ"; // এখানে আপনার নাম

    // ১. ডাটাবেজ থেকে সিট আপডেট নেওয়া (Real-time)
    onValue(ref(db, 'room1/seats'), (snapshot) => {
        const data = snapshot.val();
        for (let i = 1; i <= 2; i++) {
            const seatEl = document.getElementById(`seat-${i}`);
            const imgEl = document.getElementById(`img-${i}`);
            const nameEl = document.getElementById(`name-${i}`);
            
            if (data && data[i]) {
                imgEl.innerHTML = `<img src="https://i.pravatar.cc/100?u=${i}" class="avatar">`;
                nameEl.innerText = data[i].name;
                if (data[i].isSpeaking) seatEl.classList.add('speaking');
                else seatEl.classList.remove('speaking');
            } else {
                imgEl.innerHTML = "🛋️";
                nameEl.innerText = "খালি সিট";
                seatEl.classList.remove('speaking');
            }
        }
    });

    // ২. সিটে বসা এবং আগোরা কানেক্ট করা
    window.joinSeat = async (seatNo) => {
        if (myCurrentSeat) return;

        try {
            document.getElementById('status-bar').innerText = "ভয়েস কানেক্ট হচ্ছে...";
            
            // Agora Join
            await client.join(agoraAppId, "demo_channel", null);
            localTracks.audioTrack = await AgoraRTC.createMicrophoneAudioTrack();
            await client.publish([localTracks.audioTrack]);

            myCurrentSeat = seatNo;
            
            // Firebase Update
            const mySeatRef = ref(db, `room1/seats/${seatNo}`);
            set(mySeatRef, { name: myName, isSpeaking: false });
            
            // অ্যাপ বন্ধ করলে সিট খালি হয়ে যাবে
            onDisconnect(mySeatRef).remove();

            document.getElementById('status-bar').innerText = "🟢 আপনি লাইভ আছেন";

            // ৩. সাউন্ড ডিটেকশন লজিক
            localTracks.audioTrack.on("audio-level-updated", (level) => {
                // লেভেল ০.০৫ এর বেশি হলে কথা বলছে ধরা হবে
                const speaking = level > 0.05;
                set(ref(db, `room1/seats/${seatNo}/isSpeaking`), speaking);
            });

            client.enableAudioVolumeIndicator();

        } catch (err) {
            console.error(err);
            alert("কানেকশন ফেইলড! ব্রাউজারে মাইক্রোফোন পারমিশন চেক করুন।");
        }
    };

    // অন্যদের ভয়েস শোনার জন্য
    client.on("user-published", async (user, mediaType) => {
        await client.subscribe(user, mediaType);
        if (mediaType === "audio") {
            user.audioTrack.play();
        }
    });
</script>
</body>
</html>
